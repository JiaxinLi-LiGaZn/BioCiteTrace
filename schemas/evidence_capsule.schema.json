{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JiaxinLi-lipluszn/fulltext-citation-use-review/blob/main/schemas/evidence_capsule.schema.json",
  "title": "One-study evidence capsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capsule_version",
    "study",
    "target_method",
    "evidence_complete",
    "coverage_risk_codes",
    "version_coverage",
    "documents",
    "physical_target_occurrences"
  ],
  "properties": {
    "capsule_version": {"const": "1.0.0"},
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["study_id", "title", "identifiers"],
      "properties": {
        "study_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "title": {"type": "string", "minLength": 1, "maxLength": 1000},
        "identifiers": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "target_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_name", "aliases", "seed_identifiers"],
      "properties": {
        "canonical_name": {"type": "string", "minLength": 1, "maxLength": 300},
        "aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "seed_identifiers": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "evidence_complete": {"type": "boolean"},
    "coverage_risk_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 100}},
    "version_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version_id", "version_type", "included", "reason"],
        "properties": {
          "version_id": {"type": "string", "minLength": 1},
          "version_type": {"type": "string", "enum": ["PREPRINT", "PUBLISHED", "OTHER"]},
          "included": {"type": "boolean"},
          "reason": {"type": "string"}
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_file", "document_type", "version_id", "license", "cloud_processing_allowed", "sha256", "sections"],
        "properties": {
          "source_file": {"type": "string", "minLength": 1},
          "document_type": {"type": "string", "enum": ["MAIN", "SUPPLEMENT"]},
          "version_id": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "cloud_processing_allowed": {"const": true},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["section", "page_index", "printed_page", "paragraph_id", "text"],
              "properties": {
                "section": {"type": "string"},
                "page_index": {"type": ["integer", "null"], "minimum": 0},
                "printed_page": {"type": "string"},
                "paragraph_id": {"type": "string", "minLength": 1},
                "text": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "physical_target_occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["occurrence_id", "citation_marker", "reference_id", "source_file", "section", "page_index", "printed_page", "paragraph_id", "quote"],
        "properties": {
          "occurrence_id": {"type": "string", "minLength": 1},
          "citation_marker": {"type": "string", "minLength": 1},
          "reference_id": {"type": "string"},
          "source_file": {"type": "string", "minLength": 1},
          "section": {"type": "string"},
          "page_index": {"type": ["integer", "null"], "minimum": 0},
          "printed_page": {"type": "string"},
          "paragraph_id": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
